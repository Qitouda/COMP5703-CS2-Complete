# Copy to .env at the repository root; fill in your own credentials.
# This file is for the root docker-compose.yml, not backend/docker-compose.yml.
# Docker Compose v2.24+ is required. Only localhost ports are published.
PAPERTRACE_PORT=8080
PAPERTRACE_API_PORT=8000
PAPERTRACE_IMAGE_TAG=20261031

# Real analysis defaults. With an empty key, the app starts but GPT is unavailable.
LLM_PROVIDER=openai
PARSER_PROVIDER=generic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
RELAY_COOLDOWN_SECONDS=150
LOG_LEVEL=INFO

# Optional compatible model endpoints. Enable only after testing your credentials.
# Code discovery for all models also uses the OpenAI search channel.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://www.yunzhuhub.com/v1
ANTHROPIC_MODEL=claude-sonnet-5
CLAUDE_ENABLED=false
ANTHROPIC_CHAT_TRANSPORT=sse
GEMINI_API_KEY=
GEMINI_BASE_URL=https://www.yunzhuhub.com/v1
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_ENABLED=false
GEMINI_CHAT_TRANSPORT=sse
GEMINI_REASONING_EFFORT=minimal
GEMINI_THINKING_HEADROOM=0

# Optional read-only GitHub quota and Crossref contact identification.
GITHUB_TOKEN=
CROSSREF_MAILTO=
CROSSREF_MIN_INTERVAL_SECONDS=1
CROSSREF_TIMEOUT_SECONDS=15
CROSSREF_BRANCH_DEADLINE_SECONDS=600
REFERENCE_FALLBACK_DEADLINE_SECONDS=600

# Optional help assistant: docker compose --profile assistant up -d --build
# Blank assistant credentials fall back to OPENAI_* when configured.
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
