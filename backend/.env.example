# 当前本地运行配置的可移植模板（2026-10-30）；复制成 .env 后填写自己的密钥。
# 所有相对路径均以 backend/ 为工作目录。切勿把 .env 提交到 git。
APP_ENV=dev
LOG_LEVEL=INFO

# 数据库：默认 SQLite，升级到完整版时改成 postgresql+psycopg://user:pass@localhost:5432/cs2
DATABASE_URL=sqlite:///./data/cs2.db

# 任务执行方式：inline（FastAPI 后台任务，默认）| celery（完整版）
TASK_RUNNER=inline
REDIS_URL=redis://localhost:6379/0

# GPT 为默认模型；fixture 仅供离线测试。三个 API Key 分别填写。
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium
# Claude / Gemini 使用当前已启用的兼容中转配置（/chat/completions）。
# 换用其他端点或模型后应重新做最小样本验证；两者的代码检索共用 OPENAI_API_KEY。
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://www.yunzhuhub.com/v1
ANTHROPIC_MODEL=claude-sonnet-5
CLAUDE_ENABLED=true
ANTHROPIC_CHAT_TRANSPORT=sse
# Optional content-free JSONL attempt ledger for explicitly selected SSE clients.
COMPATIBLE_SSE_AUDIT_PATH=./data/sse-usage.jsonl
GEMINI_API_KEY=
GEMINI_BASE_URL=https://www.yunzhuhub.com/v1
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_ENABLED=true
# json | sse；当前 Claude/Gemini 均使用 SSE。
GEMINI_CHAT_TRANSPORT=sse
GEMINI_REASONING_EFFORT=minimal
GEMINI_THINKING_HEADROOM=0
# HTTPX 单次连接／读取等待；SSE 每次读取的空闲上限，不是整篇任务的总时限。
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2

# scripts/serve_local.py 使用的中转容量门控：并发 1，超时后冷却 150 秒。
# 对当前 yunzhuhub 模型端点生效；普通 make run 不安装这层门控。
RELAY_CAPACITY_STATE_DIR=./data/.relay-capacity
RELAY_COOLDOWN_SECONDS=150

# 可选：提高公开 GitHub 仓库只读核查额度；仍受 GitHub 限流约束。
GITHUB_TOKEN=
# 每次代码核查的来源读取总上限（GitHub、项目页、Search、Fetch 共用），默认 60，范围 1–200。
# CREDIBILITY_CODE_MAX_SOURCE_READS=60

# Crossref 联系邮箱仅放在请求 User-Agent。所有后端 worker 必须共用这个 SQLite 路径。
CROSSREF_MAILTO=
CROSSREF_STATE_PATH=./data/crossref/state.sqlite3
CROSSREF_MIN_INTERVAL_SECONDS=1
CROSSREF_TIMEOUT_SECONDS=15
CROSSREF_CACHE_TTL_SECONDS=604800
CROSSREF_BRANCH_DEADLINE_SECONDS=600
CREDIBILITY_CROSSREF_WAIT_BUDGET_SECONDS=60

# Crossref 之后自动补查 arXiv 与官方出版来源，不调用大模型。
REFERENCE_MULTISOURCE_ENABLED=true
# 补查阶段独立于 Crossref 的全篇预算；在条目／供应商边界检查。
REFERENCE_FALLBACK_DEADLINE_SECONDS=600
# 仍未确认的引用交给有界工具 agent（搜索/读页/Crossref/arXiv）；来源文本须含原标题与作者姓才采纳。
CREDIBILITY_REFERENCE_AGENT_ENABLED=true

# 缺少已确认实现时，使用所选模型对应的搜索（GPT/Claude/Gemini 均走 OpenAI 搜索）。
# 全代码检查共享 CREDIBILITY_CODE_MAX_SOURCE_READS 次来源读取（默认 60）；发现阶段另有固定的4轮模型／8次工具预算。
CREDIBILITY_CODE_DISCOVERY_ENABLED=true
CREDIBILITY_CODE_REPRODUCTION_SEARCH_ENABLED=true
# Optional code-review output budget: default 16000, configurable up to 65536.
# CREDIBILITY_CODE_MAX_OUTPUT_TOKENS=16000
# CREDIBILITY_CODE_DISCUSSION_BATCH_SIZE=5
# CREDIBILITY_CODE_MAX_REVIEWED_DISCUSSIONS=30
# CREDIBILITY_CODE_DISCUSSION_BATCH_ROUNDS=2
CREDIBILITY_CODE_DISCOVERY_MAX_QUERIES=3
CREDIBILITY_CODE_DISCOVERY_MAX_FETCHES=4
CREDIBILITY_CODE_DISCOVERY_MAX_ROUNDS=4
CREDIBILITY_CODE_DISCOVERY_MAX_TOOL_CALLS=8

# 可信度核查读哪份全文：live（默认，后端按 PARSER_PROVIDER 自行解析，与五维一致）
# | benchmark（优先读数据组 data/data/parsed，仅用于回归与历史验收重放）
CREDIBILITY_PARSE_SOURCE=live
CREDIBILITY_WORKERS=1

# 论文解析：stub（演示）| benchmark（只加载 paper_001）| generic（通用）| grobid（预留增强）
PARSER_PROVIDER=generic
GROBID_URL=http://localhost:8070
ARXIV_CACHE_DIR=./data/arxiv
ARXIV_TIMEOUT_SECONDS=45
BENCHMARK_PARSED_DIR=../data/data/parsed/paper_001/v3
BENCHMARK_SOURCE_RECORD=../data/data/source_snapshots/paper_001/source_record.json
BENCHMARK_ARXIV_ID=2307.08122v3

# 文件存储
UPLOAD_DIR=./data/uploads
# 默认随 UPLOAD_DIR 使用 ./data/credibility-artifacts。
# 如需改到其他位置，须导出 CREDIBILITY_ARTIFACT_DIR，或使用配套 scripts/serve_local.py。
MAX_UPLOAD_MB=30
MAX_PAGE_COUNT=120

# 证据校验失败后的降级策略：to_uncertain | lower_confidence
# 契约 v0.4 未规定，等产品确认后改这里，不要改代码
EVIDENCE_DEGRADATION_POLICY=to_uncertain

# Rubric：必须与数据组 cs2-paper-benchmark/rubrics/v0.1/rubric.yaml 完全一致，
# 他们的 rubric_versions 表拿 (rubric_id, rubric_version) 做外键
RUBRIC_ID=iclr_inspired_due_diligence
RUBRIC_VERSION=0.1-draft
# 默认使用后端随版本发布的 Rubric；联仓时可覆盖为 ../data/rubrics/v0.1
RUBRIC_DIR=./app/rubrics/v0.1
