FROM node:22-alpine
WORKDIR /app
RUN mkdir -p /app/assistant /app/data && chown -R node:node /app
COPY --chown=node:node assistant/server.mjs assistant/guide.md ./assistant/
ENV ASSISTANT_HOST=0.0.0.0 \
    ASSISTANT_PORT=8020 \
    ASSISTANT_FEEDBACK_FILE=/app/data/feedback.jsonl
USER node
EXPOSE 8020
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8020/assistant/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "assistant/server.mjs"]
